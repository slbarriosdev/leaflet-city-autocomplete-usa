{
  "name": "leaflet-city-autocomplete-usa",
  "version": "1.3.0",
  "description": "A Leaflet plugin that adds an autocomplete control for all U.S. cities, states, and ZIP codes using U.S. Census Gazetteer data.",
  "main": "dist/leaflet.cityAutocompleteUSA.js",
  "module": "dist/leaflet.cityAutocompleteUSA.esm.js",
  "style": "dist/leaflet.cityAutocompleteUSA.css",
  "exports": {
    ".": {
      "import": "./dist/leaflet.cityAutocompleteUSA.esm.js",
      "require": "./dist/leaflet.cityAutocompleteUSA.js"
    },
    "./dist/*": "./dist/*",
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "npx serve .",
    "build": "echo 'No build step required'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slbarriosdev/leaflet-city-autocomplete-usa.git"
  },
  "keywords": [
    "leaflet",
    "plugin",
    "autocomplete",
    "usa",
    "map",
    "control",
    "geosearch",
    "city-search",
    "openstreetmap",
    "zip-code",
    "esm"
  ],
  "author": "Sergio Barrios",
  "license": "MIT",
  "peerDependencies": {
    "leaflet": ">=1.7.0"
  },
  "devDependencies": {
    "leaflet": "^1.9.4"
  }
}
